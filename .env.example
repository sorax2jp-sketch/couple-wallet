# Copy to .env.local for local development. .env.local is ignored by Git.
# VITE_* values are PUBLIC: they are embedded into the browser bundle.
# Use the Web app config from Firebase Console > Project settings > Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# PUBLIC score-based reCAPTCHA Enterprise WEBSITE site key (key ID).
# No legacy v3 secret, API secret, or service-account key is needed.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Local development only. Keep false or omit in Vercel Production.
VITE_USE_EMULATORS=false
# Never add passwords, service-account JSON, private keys, CLI tokens,
# or legacy reCAPTCHA secrets to this file or any VITE_* variable.
