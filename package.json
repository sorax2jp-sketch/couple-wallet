{
  "name": "couple-wallet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --project demo-couple-wallet --only firestore 'vitest run tests/rules.test.ts'",
    "emulators": "firebase emulators:start --project demo-couple-wallet --only auth,firestore",
    "test:integration": "firebase emulators:exec --project demo-couple-wallet --only firestore 'vitest run tests/rules.test.ts'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css}' 'tests/*.{ts,tsx}' '*.json' '*.ts' index.html README.md",
    "seed:emulator": "node scripts/seed-emulator.mjs"
  },
  "dependencies": {
    "firebase": "^13.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "firebase-tools": "^14.0.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~5.9.0",
    "vite": "^6.3.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
